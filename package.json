{
  "name": "dsh-llm-router",
  "version": "0.1.0",
  "description": "Intelligent LLM routing plugin for DeepSeek Harness — multi-model route groups, smart strategies, automatic failover, quota management, cache-affinity Stays, data anonymization, and a visual Settings UI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dsh-llm-router-doctor": "scripts/doctor.mjs"
  },
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    },
    "./settings-ui": {
      "types": "./src/settings-ui.tsx",
      "default": "./dist/settings-ui.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "compatibility.json",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/wrap-client-bundle.js",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf lib",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "router",
    "routing",
    "failover",
    "load-balancing",
    "quota-management"
  ],
  "author": "XHToken",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.11.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/XHToken/dsh-intelligent-router.git"
  },
  "bugs": {
    "url": "https://github.com/XHToken/dsh-intelligent-router/issues"
  },
  "homepage": "https://github.com/XHToken/dsh-intelligent-router#readme",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^10.12.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
